# Secrets -- never commit a key. Code reads keys only from env vars / Colab Secrets.
.env
.env.*

# Mirrored upstream data -- regenerate with `bash scripts/fetch_upstream.sh` instead of committing
# a stale copy of someone else's repo.
data/upstream/

# Real experiment output: API call caches (jsonl), translated text, annotation
# sheets AND their decoding keys (results/e4_vietnamese_style/annotation_key.json
# must never be public -- it would let anyone decode which side is markdown),
# filled-in annotator CSVs. All of it is yours to keep locally / send back
# directly, not meant to live in a public repo tied to your name or an
# annotator's. Ignore the whole directory rather than listing file types one
# by one, so a new output format doesn't accidentally slip through.
results/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
